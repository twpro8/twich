generator client {
  provider = "prisma-client"
  output   = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  @@map("users")

  id String @id @default(uuid()) @db.Uuid
  email String @unique
  password String
  username String @unique
  name String
  avatar String?
  bio String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}